# Turnstile for `pnpm run hosted:dev` and the tests: Cloudflare's public test keys, which pass every
# check. No real key belongs in this file. Production has its site key in wrangler.jsonc and its
# secret key as a Worker secret (hosted/README.md).
TURNSTILE_SITE_KEY="1x00000000000000000000BB"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Web Bot Auth for `pnpm run hosted:dev` and the tests: the Ed25519 test key of RFC 9421 (Appendix
# B.1.4), which the RFC publishes, so it signs nothing anyone trusts. Production's keys are the
# Worker secret WEB_BOT_AUTH_KEYS (hosted/README.md).
WEB_BOT_AUTH_KEYS='[{"kty":"OKP","crv":"Ed25519","x":"JrQLj5P_89iXES9-vFgrIy29clF9CC_oPPsw3c5D0bs","d":"n4Ni-HpISpVObnQMW0wOhCKROaIKqKtW_2ZYb2p9KcU"}]'

# Share links for `pnpm run hosted:dev` and the tests: keys made up for this file, so they sign
# nothing anyone trusts. Production's keys are the Worker secrets SHARE_KEY and SHARE_KEY_PREVIOUS
# (hosted/README.md).
SHARE_KEY=test-share-key-not-secret
SHARE_KEY_PREVIOUS=previous-test-share-key-not-secret

# Usage analytics (issue #57) stay off for `pnpm run hosted:dev`: nothing local goes to PostHog. The
# workerd tests point it at a host of their own.
POSTHOG_HOST=
