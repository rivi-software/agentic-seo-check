{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The hosted MCP server (issue #35). Run Wrangler through `pnpm run hosted:dev|hosted:build|hosted:deploy`,
  // which build in the package's version and the limits below (scripts/defines.ts). The website is a
  // Worker of its own, wrangler.site.jsonc, which shares this one's limits and Durable Object.
  "name": "agentic-seo-check-mcp",
  "send_metrics": false,
  "main": "src/index.ts",
  // Node.js compatibility is on by default from 2026-08-04.
  "compatibility_date": "2026-11-01",
  // fetch() to a site on Cloudflare goes through its zone's front door (redirects, WAF, Workers), as a
  // search engine's request does, rather than straight to its origin.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // The server's own paths on agentic-seo.org (issue #168), whose custom domain is the website's
  // (wrangler.site.jsonc): Cloudflare runs a route before a custom domain on the same hostname. The
  // first route's hostname is also the one `hosted:dev` gives its requests. Then the server's
  // hostnames before, which keep answering at /mcp and send the rest to agentic-seo.org
  // (FORMER_SERVER_HOSTS), and serve the key directory that Signature-Agent names (BOT_ORIGIN).
  "routes": [
    { "pattern": "agentic-seo.org/mcp", "zone_name": "agentic-seo.org" },
    { "pattern": "agentic-seo.org/crawler", "zone_name": "agentic-seo.org" },
    {
      "pattern": "agentic-seo.org/.well-known/http-message-signatures-directory",
      "zone_name": "agentic-seo.org"
    },
    {
      "pattern": "agentic-seo.org/.well-known/openai-apps-challenge",
      "zone_name": "agentic-seo.org"
    },
    { "pattern": "mcp.agentic-seo.rivi.software", "custom_domain": true },
    { "pattern": "mcp.agentic-seo-check.rivi.software", "custom_domain": true },
    // The premium server (issue #229): the same tools behind an account's sign-in, with OAuth's
    // endpoints and discovery documents, which agentic-seo.org never serves (src/premium/).
    { "pattern": "premium.agentic-seo.org", "custom_domain": true }
  ],
  // The pages' fonts and share images (src/ui/assets.ts), bundled as their bytes.
  "rules": [{ "type": "Data", "globs": ["**/*.woff2", "**/*.png"], "fallthrough": true }],
  // Copies posthog-js's browser build to .generated/posthog-js.txt, which the Worker bundles as text
  // and serves at /ph.js (issue #57), and its session recorder to .generated/posthog-recorder.txt,
  // served at /ph-recorder.js (issue #181).
  "build": { "command": "node scripts/posthog-js.ts" },
  "workers_dev": false,
  "preview_urls": false,
  // A crawl at the caps (100 pages, both audits) took 6 s of CPU on a laptop with 113 KB pages
  // (issue #73); Cloudflare's machines are slower and pages may be larger. Workers Paid allows 300 s.
  "limits": { "cpu_ms": 120000 },
  // The optional packages behind rendering and Lighthouse, which the hosted server leaves out: each import
  // gets a module that fails to load, as a missing package does.
  "alias": {
    "playwright": "./src/unavailable.ts",
    "lighthouse": "./src/unavailable.ts",
    "lighthouse/core/config/desktop-config.js": "./src/unavailable.ts",
    "chrome-launcher": "./src/unavailable.ts"
  },
  // Approximate, and counted per Cloudflare location. The landing page and the refusals state these numbers.
  // wrangler.site.jsonc has the same namespaces, so the website's form counts in the same limits.
  "ratelimits": [
    // Requests to one hostname, from every caller together: a crawl at the caps sends about 300.
    { "name": "SITE_REQUESTS", "namespace_id": "35001", "simple": { "limit": 600, "period": 60 } },
    // Tool calls per IP address (seo_list_rules is not counted), and the crawls among them.
    { "name": "CALLER_CALLS", "namespace_id": "35002", "simple": { "limit": 30, "period": 60 } },
    { "name": "CALLER_CRAWLS", "namespace_id": "35003", "simple": { "limit": 3, "period": 60 } },
    // claude.ai and ChatGPT call from their platforms' own addresses: one caller each, with ten times the limits.
    { "name": "PLATFORM_CALLS", "namespace_id": "35004", "simple": { "limit": 300, "period": 60 } },
    { "name": "PLATFORM_CRAWLS", "namespace_id": "35005", "simple": { "limit": 30, "period": 60 } },
    // Reports one IP address may share a minute, uploaded to the website or kept by the MCP server's
    // seo_share_report (src/shared-reports.ts).
    { "name": "SHARE_UPLOADS", "namespace_id": "35006", "simple": { "limit": 5, "period": 60 } },
    // Sign-in codes one IP address may ask for a minute (src/accounts/codes.ts, issue #229), shared
    // with the website's account pages, so both forms count together.
    { "name": "SIGN_IN_CODES", "namespace_id": "35008", "simple": { "limit": 5, "period": 60 } }
  ],
  // The day's count of outgoing requests, the sites each caller audited today, and ChatGPT's
  // connector addresses. The website binds it too.
  "durable_objects": { "bindings": [{ "name": "STATE", "class_name": "HostedState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HostedState"] }],
  // Shared reports (src/shared-reports.ts): each kept for 30 days in the EU, under a random id. The
  // bucket's lifecycle rule deletes them: `wrangler r2 bucket lifecycle add
  // agentic-seo-check-shared-reports expire-reports reports/ --expire-days 30 --jurisdiction eu`.
  // Background crawls (src/crawls.ts, issue #209) are kept beside them for 7 days (CRAWL_DAYS), and
  // a rule of their own deletes them: `wrangler r2 bucket lifecycle add
  // agentic-seo-check-shared-reports expire-crawls crawls/ --expire-days 7 --jurisdiction eu`.
  "r2_buckets": [
    {
      "binding": "SHARED_REPORTS",
      "bucket_name": "agentic-seo-check-shared-reports",
      "jurisdiction": "eu"
    }
  ],
  // The premium accounts (issue #229), the website's database (wrangler.site.jsonc), which applies
  // its migrations: the premium server reads an account and writes sign-in codes.
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "agentic-seo-check-accounts",
      // A placeholder until RIVI creates the database (`wrangler d1 create
      // agentic-seo-check-accounts --jurisdiction eu`) and puts its id here. Local runs take any id.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations-accounts"
    }
  ],
  // The OAuth grants and tokens of the premium server (src/premium/provider.ts), kept by
  // @cloudflare/workers-oauth-provider as hashes, with each grant's props encrypted.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // A placeholder until RIVI creates the namespace in the EU (`wrangler kv namespace create
      // agentic-seo-check-oauth --jurisdiction=eu`) and puts its id here. Local runs take any id.
      "id": "00000000000000000000000000000000"
    }
  ],
  // Cloudflare Email Service, for the premium server's sign-in codes. Locally, Wrangler keeps each
  // email instead of sending it.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["premium@rivi.software"] }],
  // A deploy fails until these are set on the Worker (`pnpm run hosted:secret <NAME>`), rather than
  // put the premium server live with a sign-in that no person can pass, or the requests unsigned.
  // With a list here, local runs load only these from .dev.vars, so the list names every secret
  // .dev.vars gives this Worker. CRUX_API_KEY stays optional.
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "WEB_BOT_AUTH_KEYS"] },
  // The Workflow that runs a background crawl seo_start_crawl started (src/crawls.ts, issue #209).
  // The website starts none, so its configuration binds none.
  "workflows": [
    { "name": "agentic-seo-check-crawls", "binding": "CRAWLS", "class_name": "CrawlWorkflow" }
  ],
  // One record per tool call: the tool, the outcome, the duration, the requests and pages, the target hostname.
  // Analytics Engine keeps data for three months.
  "analytics_engine_datasets": [{ "binding": "CALLS", "dataset": "agentic_seo_check_calls" }],
  // Fetches OpenAI's list of ChatGPT connector addresses once a day.
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    // "open"; "no-crawls" refuses crawls; "closed" refuses every tool call. Change it and deploy. The
    // website's form has a MODE of its own, in wrangler.site.jsonc.
    "MODE": "open",
    // Outgoing requests a day, all callers together: past it, audits that request sites wait for 00:00 UTC.
    // The website checks the same count against its own copy of this number, which a test holds equal.
    "DAILY_REQUESTS": 100000,
    // Different sites (hostnames, without www.) one caller may audit a day (issue #73): an IP
    // address, or claude.ai and ChatGPT, each for all its users together. A site audited today
    // stays open to its caller until 00:00 UTC.
    "CALLER_SITES": 10,
    "PLATFORM_SITES": 100,
    // Where the Durable Object runs and keeps its data (src/state.ts, issue #78): the codes of the
    // daily cap on sites stay in the EU. .dev.vars sets "none" for local runs, since workerd has no
    // jurisdictions. Both Workers name the same, so that they share one object.
    "STATE_JURISDICTION": "eu",
    // The token OpenAI asks the domain to serve at /.well-known/openai-apps-challenge (#33); none yet.
    "OPENAI_APPS_CHALLENGE": "",
    // Usage analytics in PostHog's EU project "Agentic SEO" (issue #57): the pages' pageviews and
    // events, after their consent banner's rules, and one event per MCP tool call. It is the managed
    // proxy POSTHOG_HOST names in src/telemetry/posthog.ts, which the website's CSP allows. Empty
    // turns both off; .dev.vars empties it for local runs.
    "POSTHOG_HOST": "https://g.rivi.software",
    // The address the sign-in codes come from, which the send_email binding above allows. Empty
    // turns signing in to the premium server off.
    "ACCOUNTS_FROM": "premium@rivi.software",
    // The public site key of the Turnstile widget on the premium server's sign-in, the website's.
    // Its secret key is the Worker secret TURNSTILE_SECRET_KEY. .dev.vars has Cloudflare's test keys.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF7cZ5A-51MpK6BR",
    // "on" lets a request with the header x-agentic-seo-premium: 1 reach the premium server on any
    // hostname, for `hosted:dev` and the tests, whose requests all carry the first route's hostname.
    // .dev.vars turns it on; production keeps it off.
    "PREMIUM_DEV": "off"
  },
  // Errors only, as the Worker logs them: no invocation logs, which carry request details.
  // Traces stay off (issue #208): the span of every outgoing fetch keeps url.full, url.path and
  // server.address, so a trace would hold the audited page's address and hostname, and no setting
  // drops them (redact_query_string takes out the query only). Off is stated, not left out,
  // because Cloudflare plans to turn traces on wherever observability is enabled.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
