{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The website (issue #39), a Worker of its own so that it deploys with each change to main, while
  // the MCP server (wrangler.jsonc) deploys with each npm release. Run Wrangler through
  // `pnpm run site:dev|site:build|site:deploy`, which build in the package's version and the limits
  // below (scripts/defines.ts). What both Workers share is held equal by hosted/test/configs.test.ts.
  "name": "agentic-seo-check-site",
  "send_metrics": false,
  "main": "src/site/worker.ts",
  "compatibility_date": "2026-11-01",
  // fetch() to a site on Cloudflare goes through its zone's front door, as the MCP server's does.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Its hostname is also the one `site:dev` gives its requests.
  "routes": [{ "pattern": "agentic-seo.rivi.software", "custom_domain": true }],
  // The pages' fonts and share images (src/ui/assets.ts), and the fonts of a shared result's image
  // (src/ui/share-image.ts), bundled as their bytes; resvg, which draws that image, as WebAssembly.
  "rules": [
    { "type": "Data", "globs": ["**/*.woff2", "**/*.png", "**/*.ttf"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  // Copies posthog-js's browser build to .generated/posthog-js.txt, served at /ph.js (issue #57).
  "build": { "command": "node scripts/posthog-js.ts" },
  "workers_dev": false,
  "preview_urls": false,
  // `pnpm run site:dev` beside `pnpm run hosted:dev`, which serves the Durable Object on 8787.
  "dev": { "port": 8788 },
  // A crawl from the form costs what the MCP server's does.
  "limits": { "cpu_ms": 120000 },
  // The optional packages behind rendering and Lighthouse, which the website leaves out, as the MCP
  // server does.
  "alias": {
    "playwright": "./src/unavailable.ts",
    "lighthouse": "./src/unavailable.ts",
    "lighthouse/core/config/desktop-config.js": "./src/unavailable.ts",
    "chrome-launcher": "./src/unavailable.ts"
  },
  // The MCP server's rate limits, namespaces and all: a run of the form counts as a call of its IP
  // address, and its requests to a site count with the MCP server's.
  "ratelimits": [
    { "name": "SITE_REQUESTS", "namespace_id": "35001", "simple": { "limit": 600, "period": 60 } },
    { "name": "CALLER_CALLS", "namespace_id": "35002", "simple": { "limit": 30, "period": 60 } },
    { "name": "CALLER_CRAWLS", "namespace_id": "35003", "simple": { "limit": 3, "period": 60 } },
    { "name": "PLATFORM_CALLS", "namespace_id": "35004", "simple": { "limit": 300, "period": 60 } },
    { "name": "PLATFORM_CRAWLS", "namespace_id": "35005", "simple": { "limit": 30, "period": 60 } }
  ],
  // The MCP server's Durable Object, so the form's requests count in the same day. It runs the code
  // the MCP server last deployed: see deploy-site.yml before changing src/state.ts.
  "durable_objects": {
    "bindings": [
      { "name": "STATE", "class_name": "HostedState", "script_name": "agentic-seo-check-mcp" }
    ]
  },
  // The MCP server's dataset: one record per run of the form, as per tool call.
  "analytics_engine_datasets": [{ "binding": "CALLS", "dataset": "agentic_seo_check_calls" }],
  // A deploy fails until these are set on the Worker (`pnpm run site:secret <NAME>`), rather than
  // put the website live with its form off, its requests unsigned and no Share button.
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "WEB_BOT_AUTH_KEYS", "SHARE_KEY"] },
  "vars": {
    // "open"; "no-crawls" audits a homepage alone; "closed" turns the form off. Change it and deploy.
    "MODE": "open",
    // The MCP server's DAILY_REQUESTS, CALLER_SITES and PLATFORM_SITES: the form checks the day's
    // counts it shares with the MCP server against them (issue #73).
    "DAILY_REQUESTS": 100000,
    "CALLER_SITES": 10,
    "PLATFORM_SITES": 100,
    // The public site key of the Turnstile widget ("agentic-seo-check website audit form",
    // invisible). Its secret key is the Worker secret TURNSTILE_SECRET_KEY; the audit form is off
    // when either is missing. .dev.vars has Cloudflare's test keys for local runs.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF7cZ5A-51MpK6BR",
    // Where the Durable Object runs and keeps its data (src/state.ts, issue #78): the codes of the
    // daily cap on sites stay in the EU. .dev.vars sets "none" for local runs, since workerd has no
    // jurisdictions. Both Workers name the same, so that they share one object.
    "STATE_JURISDICTION": "eu",
    // Usage analytics in PostHog's EU project "Agentic SEO" (issue #57): the pages' pageviews and
    // events, after the consent banner's rules. Empty turns them off; .dev.vars empties it for
    // local runs.
    "POSTHOG_HOST": "https://eu.i.posthog.com"
  },
  // Errors only, as the Worker logs them: no invocation logs, which carry request details.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false }
  }
}
