{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The website (issue #39), a Worker of its own beside the MCP server's (wrangler.jsonc). Both deploy
  // with each change to main, the MCP server first (deploy-hosted.yml). Run Wrangler through
  // `pnpm run site:dev|site:build|site:deploy`, which build in the package's version and the limits
  // below (scripts/defines.ts). What both Workers share is held equal by hosted/test/configs.test.ts.
  "name": "agentic-seo-check-site",
  "send_metrics": false,
  "main": "src/site/worker.ts",
  "compatibility_date": "2026-11-01",
  // fetch() to a site on Cloudflare goes through its zone's front door, as the MCP server's does.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Its hostname, which it shares with the MCP server: that Worker's routes there take the server's
  // own paths (wrangler.jsonc, issue #168). It is also the one `site:dev` gives its requests. Then
  // its hostname before, which sends every request to agentic-seo.org (FORMER_SITE_HOST).
  "routes": [
    { "pattern": "agentic-seo.org", "custom_domain": true },
    { "pattern": "agentic-seo.rivi.software", "custom_domain": true }
  ],
  // The fonts of a shared result's image (src/ui/share-image.ts), bundled as their bytes; resvg,
  // which draws that image, as WebAssembly.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  // Writes the website's fixed files into .generated/assets/ (scripts/assets.ts, issue #202): the
  // pages' script and fonts, the favicon, the share images, posthog-js and its recorder, and pdfmake
  // with a report's PDF fonts.
  "build": { "command": "node scripts/assets.ts" },
  // Those files, served before the Worker runs: a request for one costs no invocation, and
  // Cloudflare sends their ETag and 304 itself. Every other path reaches the Worker. Their headers
  // are in the directory's _headers.
  "assets": { "directory": ".generated/assets" },
  "workers_dev": false,
  "preview_urls": false,
  // `pnpm run site:dev` beside `pnpm run hosted:dev`, which serves the Durable Object on 8787.
  "dev": { "port": 8788 },
  // A crawl from the form costs what the MCP server's does.
  "limits": { "cpu_ms": 120000 },
  // The optional packages behind rendering and Lighthouse, which the website leaves out, as the MCP
  // server does.
  "alias": {
    "playwright": "./src/unavailable.ts",
    "lighthouse": "./src/unavailable.ts",
    "lighthouse/core/config/desktop-config.js": "./src/unavailable.ts",
    "chrome-launcher": "./src/unavailable.ts"
  },
  // The MCP server's rate limits, namespaces and all: a run of the form counts as a call of its IP
  // address, and its requests to a site count with the MCP server's.
  "ratelimits": [
    { "name": "SITE_REQUESTS", "namespace_id": "35001", "simple": { "limit": 600, "period": 60 } },
    { "name": "CALLER_CALLS", "namespace_id": "35002", "simple": { "limit": 30, "period": 60 } },
    { "name": "CALLER_CRAWLS", "namespace_id": "35003", "simple": { "limit": 3, "period": 60 } },
    { "name": "PLATFORM_CALLS", "namespace_id": "35004", "simple": { "limit": 300, "period": 60 } },
    { "name": "PLATFORM_CRAWLS", "namespace_id": "35005", "simple": { "limit": 30, "period": 60 } },
    // Reports one IP address may share a minute, uploaded to the website or kept by the MCP server's
    // seo_share_report (src/shared-reports.ts).
    { "name": "SHARE_UPLOADS", "namespace_id": "35006", "simple": { "limit": 5, "period": 60 } },
    // Signups to the premium waitlist one IP address may send a minute (src/site/waitlist.ts,
    // issue #232): the website's alone, so the MCP server's configuration has no such namespace.
    { "name": "WAITLIST_SIGNUPS", "namespace_id": "35007", "simple": { "limit": 5, "period": 60 } }
  ],
  // The MCP server's Durable Object, so the form's requests count in the same day. It runs the code
  // the MCP server last deployed, which deploys first: keep its methods additive (src/state.ts).
  "durable_objects": {
    "bindings": [
      { "name": "STATE", "class_name": "HostedState", "script_name": "agentic-seo-check-mcp" }
    ]
  },
  // Shared reports (src/shared-reports.ts): each kept for 30 days in the EU, under a random id. The
  // bucket's lifecycle rule deletes them: `wrangler r2 bucket lifecycle add
  // agentic-seo-check-shared-reports expire-reports reports/ --expire-days 30 --jurisdiction eu`.
  "r2_buckets": [
    {
      "binding": "SHARED_REPORTS",
      "bucket_name": "agentic-seo-check-shared-reports",
      "jurisdiction": "eu"
    }
  ],
  // The premium waitlist (issue #232): the addresses, their answers and when each was confirmed, in
  // the EU. Its tables are in migrations/, which the deploy job applies before it deploys the
  // website (`pnpm run site:migrate`).
  "d1_databases": [
    {
      "binding": "WAITLIST",
      "database_name": "agentic-seo-check-waitlist",
      "database_id": "b43422ec-7419-40cd-ba78-9a78a09fde39",
      "migrations_dir": "migrations"
    }
  ],
  // Once a day: the waitlist's unconfirmed addresses whose link has run out are deleted (worker.ts).
  "triggers": { "crons": ["17 3 * * *"] },
  // Cloudflare Email Service, for the waitlist's emails: the link that confirms an address. It may
  // send from WAITLIST_FROM only. Locally, Wrangler writes each email to a file instead.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["premium@rivi.software"] }],
  // The MCP server's dataset: one record per run of the form, as per tool call.
  "analytics_engine_datasets": [{ "binding": "CALLS", "dataset": "agentic_seo_check_calls" }],
  // A deploy fails until these are set on the Worker (`pnpm run site:secret <NAME>`), rather than
  // put the website live with its form off, its requests unsigned and no Share button.
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "WEB_BOT_AUTH_KEYS", "SHARE_KEY"] },
  "vars": {
    // "open"; "no-crawls" audits a homepage alone; "closed" turns the form off. Change it and deploy.
    "MODE": "open",
    // The MCP server's DAILY_REQUESTS, CALLER_SITES and PLATFORM_SITES: the form checks the day's
    // counts it shares with the MCP server against them (issue #73).
    "DAILY_REQUESTS": 100000,
    "CALLER_SITES": 10,
    "PLATFORM_SITES": 100,
    // The public site key of the Turnstile widget ("agentic-seo-check website audit form",
    // invisible). Its secret key is the Worker secret TURNSTILE_SECRET_KEY; the audit form is off
    // when either is missing. .dev.vars has Cloudflare's test keys for local runs.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF7cZ5A-51MpK6BR",
    // Where the Durable Object runs and keeps its data (src/state.ts, issue #78): the codes of the
    // daily cap on sites stay in the EU. .dev.vars sets "none" for local runs, since workerd has no
    // jurisdictions. Both Workers name the same, so that they share one object.
    "STATE_JURISDICTION": "eu",
    // Usage analytics in PostHog's EU project "Agentic SEO" (issue #57): the pages' pageviews and
    // events, after the consent banner's rules. It is the managed proxy POSTHOG_HOST names in
    // src/telemetry/posthog.ts, which the CSP allows. Empty turns them off; .dev.vars empties it
    // for local runs.
    "POSTHOG_HOST": "https://g.rivi.software",
    // The address the waitlist's emails come from, on a domain onboarded to Email Service; the
    // send_email binding above allows it. Empty turns the waitlist's form off.
    "WAITLIST_FROM": "premium@rivi.software"
  },
  // Errors only, as the Worker logs them: no invocation logs, which carry request details.
  // Traces stay off (issue #208): the span of every outgoing fetch keeps url.full, url.path and
  // server.address, so a trace would hold the audited page's address and hostname, and no setting
  // drops them (redact_query_string takes out the query only). Off is stated, not left out,
  // because Cloudflare plans to turn traces on wherever observability is enabled.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
