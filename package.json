{
  "name": "@rivi-software/agentic-seo-check",
  "version": "0.5.0",
  "description": "SEO and AEO analysis for coding agents: a CLI and MCP server that audit URLs, static build output or raw HTML for search engines and AI answer engines, and return machine-actionable findings.",
  "license": "MIT",
  "author": "RIVI Software (https://rivi.software)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rivi-software/agentic-seo-check.git"
  },
  "homepage": "https://github.com/rivi-software/agentic-seo-check#readme",
  "bugs": {
    "url": "https://github.com/rivi-software/agentic-seo-check/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@12.15.0",
  "bin": {
    "agentic-seo-check": "./dist/cli.js",
    "agentic-seo-check-mcp": "./dist/mcp-bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-bin.ts",
    "check": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "ultracite fix -A unicorn/catch-error-name -A typescript/consistent-type-definitions -A unicorn/prefer-dom-node-append -A unicorn/prefer-dom-node-dataset -A unicorn/prefer-query-selector -A unicorn/prefer-at -A unicorn/prefer-set-has -A unicorn/prefer-spread -A unicorn/prefer-bigint-literals -A unicorn/prefer-import-meta-properties -A unicorn/prefer-number-coercion -A unicorn/prefer-type-error -A unicorn/prefer-regexp-test -A unicorn/text-encoding-identifier-case -A unicorn/no-useless-undefined -A vitest/prefer-describe-function-title",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.ts",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run test && pnpm run build && pnpm run check:package",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "seo",
    "aeo",
    "answer-engine-optimization",
    "ai-crawlers",
    "llms-txt",
    "audit",
    "mcp",
    "model-context-protocol",
    "cli",
    "coding-agents",
    "lighthouse",
    "crawler"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "css-select": "^7.0.0",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "fast-xml-parser": "^5.12.0",
    "parse5": "^8.1.1",
    "parse5-htmlparser2-tree-adapter": "^8.0.2",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.0"
  },
  "peerDependenciesMeta": {
    "chrome-launcher": {
      "optional": true
    },
    "lighthouse": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "chrome-launcher": "^1.2.3",
    "lefthook": "2.2.2",
    "lighthouse": "^13.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "^1.65.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vitest": "^5.1.0"
  }
}
